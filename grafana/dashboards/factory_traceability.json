      "title": "Part Timeline â€” Full Event History & Flags",
      "description": "Select any part_id to see its complete event journey through all stations, along with any data quality flags raised",
      "type": "table",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "factory-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  pe.part_id,\n  p.product_line,\n  pe.station,\n  pe.event_type,\n  pe.event_ts,\n  pe.source_file,\n  COALESCE(\n    STRING_AGG(DISTINCT dqf.flag_type, ', '),\n    'âœ“ Clean'\n  ) AS flag_types,\n  COALESCE(\n    STRING_AGG(DISTINCT dqf.description, ' | '),\n    ''\n  ) AS flag_details\nFROM part_events pe\nLEFT JOIN parts p ON pe.part_id = p.part_id\nLEFT JOIN data_quality_flags dqf ON pe.event_id = dqf.event_id\nGROUP BY pe.event_id, pe.part_id, p.product_line, pe.station, pe.event_type, pe.event_ts, pe.source_file\nORDER BY pe.part_id, pe.event_ts NULLS LAST;",
          "refId": "A"
        }
      ]
