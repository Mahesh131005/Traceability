          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  pe.part_id,\n  p.product_line,\n  COUNT(DISTINCT dqf.flag_id) AS flag_count,\n  STRING_AGG(DISTINCT dqf.flag_type, ', ') AS flag_types\nFROM part_events pe\nLEFT JOIN parts p ON pe.part_id = p.part_id\nJOIN data_quality_flags dqf ON pe.event_id = dqf.event_id\nGROUP BY pe.part_id, p.product_line\nORDER BY flag_count DESC\nLIMIT 20;",
