      "title": "Traceability Completeness %",
      "description": "Percentage of parts that have all 3 expected station events (component_scan, quality_check, packaging)",
      "type": "gauge",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "factory-postgres-ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n  ROUND(\n    (COUNT(DISTINCT CASE WHEN station_count = 3 THEN part_id END)::numeric \n     / NULLIF(COUNT(DISTINCT part_id), 0)::numeric) * 100, \n    1\n  ) AS traceability_pct\nFROM (\n  SELECT part_id, COUNT(DISTINCT station) AS station_count\n  FROM part_events\n  WHERE part_id IN (SELECT part_id FROM parts)\n  GROUP BY part_id\n) sub;",
          "refId": "A"
        }
      ]
    },
